PORT=4000

# Unique per-service identity secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
USER_SERVICE_SECRET=replace_with_generated_secret
PAYMENT_SERVICE_SECRET=replace_with_generated_secret
DB_SERVICE_SECRET=replace_with_generated_secret

# Context-aware policy checks (Step 7)
ALLOWED_HOURS_START=0
ALLOWED_HOURS_END=24
MAX_PAYLOAD_BYTES=10240

# Rate limiting (Step 8) — per-service, fixed window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=10000
